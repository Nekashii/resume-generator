<article>
  <h1>{{ basics.fullName }}</h1>
  <p>{{ basics.jobTitle }}</p>
  <p>{{ basics.location.city }}, {{ basics.location.country }}</p>
  <p>
    <a href="mailto:{{ basics.emailAddress }}">{{ basics.emailAddress }}</a>
  </p>
  <p>
    <a href="tel:{{ basics.phoneNumber }}">{{ basics.phoneNumber }}</a>
  </p>
  {% for link in basics.links %}
    <p>
      <a href="{{ link.url }}" data-site="{{ link.site }}">{{ link.label }}</a>
    </p>
  {% endfor %}
  {% if basics.summary %}
    <section>
      {% if basics.summary.sectionTitle %}
        <h2>{{ basics.summary.sectionTitle }}</h2>
      {% endif %}
      <p>{{ basics.summary.content }}</p>
    </section>
  {% endif %}
  {% if education %}
    <section>
      <h2>{{ education.sectionTitle }}</h2>
      {% for item in education.items %}
        <article>
          <h3>{{ item.institution }}</h3>
          <p>{{ item.degree }}</p>
          {% if item.location %}
            <p>{{ item.location }}</p>
          {% endif %}
          <p>{{ item.dateRange | yearMonthRange: meta.locale }}</p>
          {% if item.summary %}
            <p>{{ item.summary }}</p>
          {% endif %}
          {% if item.highlights %}
            <ul>
              {% for highlight in item.highlights %}
                <li>{{ highlight }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}
  {% if workExperience %}
    <section>
      <h2>{{ workExperience.sectionTitle }}</h2>
      {% for item in workExperience.items %}
        <article>
          <h3>{{ item.organization }}</h3>
          <p>{{ item.position }}</p>
          {% if item.location %}
            <p>{{ item.location }}</p>
          {% endif %}
          <p>{{ item.dateRange | yearMonthRange: meta.locale }}</p>
          {% if item.summary %}
            <p>{{ item.summary }}</p>
          {% endif %}
          {% if item.highlights %}
            <ul>
              {% for highlight in item.highlights %}
                <li>{{ highlight }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}
  {% if leadershipAndActivities %}
    <section>
      <h2>{{ leadershipAndActivities.sectionTitle }}</h2>
      {% for item in leadershipAndActivities.items %}
        <article>
          <h3>{{ item.organization }}</h3>
          <p>{{ item.role }}</p>
          {% if item.location %}
            <p>{{ item.location }}</p>
          {% endif %}
          <p>{{ item.dateRange | yearMonthRange: meta.locale }}</p>
          {% if item.summary %}
            <p>{{ item.summary }}</p>
          {% endif %}
          {% if item.highlights %}
            <ul>
              {% for highlight in item.highlights %}
                <li>{{ highlight }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}
  {% if projects %}
    <section>
      <h2>{{ projects.sectionTitle }}</h2>
      {% for item in projects.items %}
        <article>
          <h3>{{ item.name }}</h3>
          <p>{{ item.dateRange | yearMonthRange: meta.locale }}</p>
          {% if item.summary %}
            <p>{{ item.summary }}</p>
          {% endif %}
          {% if item.highlights %}
            <ul>
              {% for highlight in item.highlights %}
                <li>{{ highlight }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}
  {% if certifications %}
    <section>
      <h2>{{ certifications.sectionTitle }}</h2>
      {% for item in certifications.items %}
        <article>
          <h3>{{ item.name }}</h3>
          <p>{{ item.issuer }}</p>
          {% if item.date %}
            <p>
              {{ item.date | partialDate: meta.locale }}
            </p>
          {% endif %}
          {% if item.url %}
            <a href="{{ item.url }}" target="_blank">Certificate</a>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}
  {% if skillsAndInterests %}
    <section>
      <h2>{{ skillsAndInterests.sectionTitle }}</h2>
      <ul>
        {% for item in skillsAndInterests.items %}
          <li>
            {{ item.category }}
            {% if item.items %}
              <ul>
                {% for item in item.items %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</article>
