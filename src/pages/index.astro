---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resume Generator</title>
  </head>
  <body class="w-full min-h-dvh grid grid-rows-[auto_1fr_auto] bg-gray-100">
    <header class="bg-indigo-600 text-white px-6 py-4 flex items-center gap-4">
      <h1 class="text-xl font-semibold text-center flex-1">Resume Generator</h1>
      <button
        id="printButton"
        class="border-2 border-white p-1 rounded-md hover:bg-white hover:text-indigo-600 cursor-pointer transition-colors duration-100"
      >
        Print
      </button>
    </header>
    <main class="grid p-10 justify-center">
      <div class="bg-white min-h-[11in] w-[8.5in] shadow-lg grid relative border border-gray-300 overflow-clip">
        <iframe style="width: 100%" id="container"></iframe>
        <hr class="top-[11in] absolute w-full border-dashed border-gray-300 border" />
      </div>
    </main>
    <footer class="bg-indigo-900 text-white px-6 py-3">
      <p class="text-center">
        Resume Generator | <a class="underline font-semibold" href="https://github.com/Nekashii/resume-generator">
          GitHub
        </a>
      </p>
    </footer>
    <script>
      import yaml from 'js-yaml'
      import { Liquid } from 'liquidjs'
      import { ResumeMapper } from '../mappers/resume-mapper'
      import { FileResumeSchema } from '../models/file-resume-schema'
      import type { Resume } from '../models/resume'
      import { partialDate, yearMonthRangeOrPresent } from '../utils/date-format-utils'

      const iframe = document.getElementById('container') as HTMLIFrameElement
      const engine = new Liquid()

      async function render(resumeData: Resume, resumeTemplate: string) {
        iframe.srcdoc = `
          <!DOCTYPE html>
          <html lang="${resumeData.meta.locale}">
          <head>
            <title>${resumeData.meta.name}</title>
            <style>
              html,body {
                margin:0;
                padding:0;
                overflow:hidden;
                box-sizing:border-box;
              }
            </style>
          </head>
          <body>${await engine.renderFile('template.liquid', resumeData)}</body>
          </html>
        `
      }

      iframe.onload = () => (iframe.height = iframe.contentDocument!.body.scrollHeight.toString())

      document.getElementById('printButton')!.addEventListener('click', () => iframe.contentWindow!.print())

      engine.registerFilter('partialDate', partialDate)
      engine.registerFilter('yearMonthRange', yearMonthRangeOrPresent)

      const [data, template] = await Promise.all([
        fetch('data.yaml')
          .then(res => res.text())
          .then(yaml.load)
          .then(FileResumeSchema.parseAsync)
          .then(ResumeMapper.fromFile),
        fetch('template.liquid').then(res => res.text()),
      ])

      render(data, template)
    </script>
  </body>
</html>
